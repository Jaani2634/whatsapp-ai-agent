# Copy to .env (local dev) or set these in the Botkeep panel (production).
# NEVER commit real values — .env is gitignored.

# --- WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Webhook verification (Meta developer app > WhatsApp > Configuration) ---
# VERIFY_TOKEN: any random string YOU invent; paste the same into Meta's
#   "Verify token" field when configuring the webhook.
VERIFY_TOKEN=
# APP_SECRET: Meta developer app > Settings > Basic > App Secret.
APP_SECRET=

# --- AI brain (Groq, free tier; OpenAI-compatible endpoint) ---
GROQ_API_KEY=
# MODEL_ID: must be a model id from your Groq account. Verified 2026-10-19:
#   openai/gpt-oss-120b (strongest), openai/gpt-oss-20b, qwen/qwen3.8-27b
MODEL_ID=openai/gpt-oss-120b

# --- Vision (Gemini free tier) — for customer images/videos ---
# Optional but recommended. Without it, image/video analysis is skipped
# (voice notes still work — they use Groq Whisper).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Owner (YOU) ---
# Your WhatsApp number in international format, digits only (no +, no spaces).
# The bot notifies this number on every handover; only this number's
# `resume` / `pause` / `status` commands are honoured.
OWNER_PHONE_NUMBER=

# --- Handover tuning (optional) ---
# Comma-separated topics that ALWAYS trigger human handover, e.g.:
# HANDOVER_SENSITIVE_TOPICS=refund,complaint,chargeback
HANDOVER_SENSITIVE_TOPICS=

# --- Server (optional) ---
# PORT: Botkeep injects its own PORT; default 3000 is for local dev.
PORT=3000
# DATA_DIR: where memory.db / knowledge.db / handover.db live. Defaults to ./data.
# DATA_DIR=
